<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
        <modelVersion>4.0.0</modelVersion>
        <parent>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-parent</artifactId>
                <version>3.3.5</version>
                <relativePath/> <!-- lookup parent from repository -->
        </parent>
        <groupId>cl.rutaexpress</groupId>
        <artifactId>ms-rutaexpress-envios</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <name>ms-rutaexpress-envios</name>
        <description>Microservicio de dominio para el ciclo de vida de envios</description>

        <properties>
                <java.version>17</java.version>
        </properties>

        <dependencies>
                <!-- Web REST -->
                <dependency>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-starter-web</artifactId>
                </dependency>

                <!-- JPA / Hibernate -->
                <dependency>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-starter-data-jpa</artifactId>
                </dependency>

                <!-- Validaciones (Bean Validation) -->
                <dependency>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-starter-validation</artifactId>
                </dependency>

                <!-- Seguridad: validacion de JWT emitido por Azure AD -->
                <dependency>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
                </dependency>

                <!-- Driver Oracle -->
                <dependency>
                        <groupId>com.oracle.database.jdbc</groupId>
                        <artifactId>ojdbc11</artifactId>
                        <scope>runtime</scope>
                </dependency>

                <!-- Necesarias para leer el wallet SSO (cwallet.sso) de Oracle Autonomous DB -->
                <dependency>
                        <groupId>com.oracle.database.security</groupId>
                        <artifactId>oraclepki</artifactId>
                        <scope>runtime</scope>
                </dependency>
                <dependency>
                        <groupId>com.oracle.database.security</groupId>
                        <artifactId>osdt_cert</artifactId>
                        <scope>runtime</scope>
                </dependency>
                <dependency>
                        <groupId>com.oracle.database.security</groupId>
                        <artifactId>osdt_core</artifactId>
                        <scope>runtime</scope>
                </dependency>


                <!-- Testing -->
                <dependency>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-starter-test</artifactId>
                        <scope>test</scope>
                </dependency>
        </dependencies>

        <build>
                <plugins>
                        <plugin>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-maven-plugin</artifactId>
                        </plugin>
                </plugins>
        </build>

</project>
